        "name": "Lock worker",
        "func": "const busy = flow.get('busy');\nif (busy && Date.now() - busy < 60000) return null;\nflow.set('busy', Date.now());\nmsg.topic = 'GROUP';\nmsg.payload = ['workers', env.get('HOSTNAME') || 'pod-1', 'COUNT', 1, 'STREAMS', 'trips:events', '>'];\nreturn msg;",
