    {
        "id": "4b1fc28f29cd97e4",
        "type": "function",
        "z": "8d899d103d54fcb4",
        "g": "7db6da50690ce1b8",
        "name": "Parse event",
        "func": "const r = msg.payload;\nif (!r || !r.length) { flow.set('busy', null); return null; }\nconst [id, fields] = r[0][1][0];\nmsg.entryId = id;\nmsg.body = fields[1];\nmsg.deliveries = 1;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
