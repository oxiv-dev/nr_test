    {
        "id": "ddd2e2fb0974cebd",
        "type": "function",
        "z": "8d899d103d54fcb4",
        "g": "7db6da50690ce1b8",
        "name": "Handle event",
        "func": "// handle (два виходи: 1 = на XACK, 2 = у dead-letter)\nconst sleep = ms => new Promise(r => setTimeout(r, ms));\nconst MAX = 5;\nif (msg.deliveries >= MAX) {\n    flow.set('busy', null); \n    return [null, msg];\n}\ntry {\n    await sleep(Math.random() * 10000);\n    if (Math.random() < 0.3) throw new Error('random failure');\n    console.log('processed', msg.entryId, msg.body);\n    msg.topic = 'trips:events';\n    msg.payload = ['workers', msg.entryId];\n    flow.set('busy', null);\n    return [msg, null];\n} catch (e) {\n    node.warn('failed ' + msg.entryId + ': ' + e.message);  // без XACK, запис лишається в PEL\n    flow.set('busy', null);\n    return null;\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
